# Values consumed by the production docker-compose.yml.
CLIENT_URL=http://localhost:3000
BACKEND_PORT=5000

# Generate independent random values; never deploy these placeholders.
REDIS_PASSWORD=replace-with-at-least-32-random-characters
RABBITMQ_USER=social_app
RABBITMQ_PASS=replace-with-at-least-32-random-characters
RABBITMQ_QUEUE_NAME=social_queue
RABBITMQ_BACKEND_QUEUE=backend_queue
AI_INTERNAL_API_KEY=replace-with-at-least-32-random-characters

# Optional Hugging Face token for private/rate-limited model downloads.
HF_TOKEN=
