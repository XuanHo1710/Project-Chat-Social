NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/project-chat-social

JWT_ACCESS_TOKEN_SECRET=replace-with-an-independent-32-byte-random-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-another-independent-32-byte-random-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
OTP_HASH_SECRET=replace-with-an-independent-32-byte-random-secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

RABBITMQ_URL=amqp://social_app:replace-password@localhost:5672
RABBITMQ_QUEUE_NAME=social_queue
RABBITMQ_BACKEND_QUEUE=backend_queue

KAFKA_BROKER=localhost:9092

AI_SERVER_URL=http://localhost:8000/api/v1
AI_INTERNAL_API_KEY=replace-with-the-same-random-key-used-by-all-internal-services

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
API_VIDEO_KEY=

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Social Chat
EMAIL_LOG_OTP=false

# Refresh reuse-detection grace window (seconds); replays of a just-rotated sessionId within this window are treated as benign duplicates
REFRESH_REUSE_GRACE_SECONDS=45
