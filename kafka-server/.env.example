NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/project-chat-social
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=social-feed-worker
KAFKA_CONSUMER_GROUP=newsfeed-consumer-group
KAFKA_PARTITIONS_CONCURRENT=3
KAFKA_PROCESSING_ATTEMPTS=3
KAFKA_MANAGE_TOPICS=true
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

AI_SERVER_URL=http://localhost:8000/api/v1
AI_INTERNAL_API_KEY=replace-with-the-same-random-key-used-by-all-internal-services
