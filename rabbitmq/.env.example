NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/project-chat-social
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=30

RABBITMQ_URL=amqp://social_app:replace-password@localhost:5672
RABBITMQ_QUEUE_NAME=social_queue
RABBITMQ_BACKEND_QUEUE=backend_queue
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=1000

AI_SERVER_URL=http://localhost:8000/api/v1
AI_INTERNAL_API_KEY=replace-with-the-same-random-key-used-by-all-internal-services
AI_IMAGE_ALLOWED_HOSTS=res.cloudinary.com

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
