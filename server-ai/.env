# AI Server Configuration - Ollama + Vector Database
# Copy this file to .env and configure

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# MongoDB Connection
MONGODB_URI=mongodb+srv://xuanhodcbas:0984232310ho.@cluster0.f7sbfkn.mongodb.net/project-chat-social
MONGODB_DATABASE=project-chat-social

# AI Model Configuration
# "ollama" hoặc "custom" (model tự train)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=BAAI/bge-m3

# Đường dẫn model tự train (sẽ được tạo sau khi chạy train)
CUSTOM_MODEL_PATH=./models/custom-social-embedding

# ChromaDB Local / Cloud Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_POSTS=posts
CHROMA_COLLECTION_HASHTAGS=social_hashtags_v2

# Nếu dùng Chroma Cloud, điền Host/Port của họ
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=False
CHROMA_API_TOKEN=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Ollama (vẫn dùng cho LLM generation)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Search & Recommendation
SEARCH_TOP_K=20
SIMILARITY_THRESHOLD=0.5
RECOMMENDATION_LIMIT=10

# Sync Settings
SYNC_BATCH_SIZE=60000
SYNC_INTERVAL_MINUTES=30
