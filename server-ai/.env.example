HOST=0.0.0.0
PORT=8000
DEBUG=false

# Shared by trusted backend/Kafka/Rabbit clients. Use at least 32 random bytes.
AI_INTERNAL_API_KEY=replace-with-a-long-random-service-key
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=project-chat-social

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_POSTS=post_vectors
QDRANT_COLLECTION_USERS=user_vectors
QDRANT_COLLECTION_QUERIES=query_vectors

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_SIZE=500
CHUNK_OVERLAP=100
SEARCH_TOP_K=20
RECOMMENDATION_LIMIT=20
VECTOR_CANDIDATE_LIMIT=1000

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai

# Privacy-sensitive features are opt-in.
STORE_QUERY_EMBEDDINGS=false
ENABLE_QUERY_HISTORY_API=false
LLM_RAG_ALLOW_NON_PUBLIC=false
AUTO_TRAIN=false
