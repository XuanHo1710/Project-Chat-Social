# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=social_media

# AI Model Configuration
# "ollama" hoặc "custom" (model tự train)
EMBEDDING_PROVIDER=custom
# Đường dẫn model tự train (sẽ được tạo sau khi chạy train)
CUSTOM_MODEL_PATH=./models/custom-social-embedding

# ChromaDB Online / Cloud Configuration
# Nếu dùng Cloud, điền Host/Port của họ. Nếu tự host thì điền IP server.
# Ví dụ Chroma Token-Auth:
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=False
CHROMA_API_TOKEN=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Collection Names
CHROMA_COLLECTION_POSTS=social_posts_v2
CHROMA_COLLECTION_HASHTAGS=social_hashtags_v2

# Ollama (vẫn dùng cho LLM generation)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
